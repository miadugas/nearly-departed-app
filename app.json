{
  "expo": {
    "name": "Nearly Departed",
    "slug": "nearly-departed-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nearlydepartedapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/ios-icon.png",
      "bundleIdentifier": "com.miadugas.nearlydeparted",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "24"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.miadugas.nearlydeparted"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2d1937",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-image",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nearly Departed uses your location to find the notable dead buried near you.",
          "locationAlwaysAndWhenInUsePermission": "Nearly Departed uses your location to find the notable dead buried near you.",
          "locationAlwaysPermission": "Nearly Departed uses your location to find the notable dead buried near you.",
          "motionUsagePermission": "Motion activity helps the system improve location accuracy while you explore."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://lazmmkvavwicxophadmt.supabase.co",
      "supabaseAnonKey": "sb_publishable_eWRSXhYETPUedQCOaSVO9A_Y5QuvvIH",
      "router": {},
      "eas": {
        "projectId": "59f59a4a-99e3-4dea-8237-e4ae80b8ef58"
      }
    },
    "owner": "miadugas"
  }
}
